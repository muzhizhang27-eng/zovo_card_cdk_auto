{
  "name": "cdk-recharge-system",
  "version": "1.4.27",
  "type": "module",
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11 <13"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "test": "vitest run && npm run test:grace-recovery && npm run test:redemption-flow",
    "check": "npm run build && npm test",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "test:grace-recovery": "node scripts/test-grace-recovery.mjs",
    "test:redemption-flow": "node scripts/test-redemption-flow.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^10.7.2",
    "chart.js": "^4.4.1",
    "element-plus": "^2.14.2",
    "pinia": "^2.1.7",
    "vue": "^3.4.30",
    "vue-chartjs": "^5.3.1",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.2.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "^2.4.3",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.20.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.1",
    "typescript": "5.9.3",
    "vite": "^7.3.7",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
