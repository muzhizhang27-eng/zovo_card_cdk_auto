# Copy to .env.local, then generate and save a secret with: openssl rand -hex 32
JWT_SECRET=
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_MODE=debug
INSTALL_MODE=wizard
FRONTEND_PORT=5173
# start-dev.sh supplies absolute SQLite and frontend paths automatically.
# DB_PATH=/absolute/path/to/data/cdk_recharge.db
# The backend uses environment proxy settings, not macOS system proxy settings.
# Set these to your local HTTP proxy, if required:
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
NO_PROXY=localhost,127.0.0.1,::1
# Existing card_api_base/card_api_key in SQLite take precedence over these:
# CARD_API_BASE=https://zovocard.com
# CARD_API_KEY=
