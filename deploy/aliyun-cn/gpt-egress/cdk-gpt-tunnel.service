[Unit]
Description=Private Singapore ChatGPT tunnel for CDK (Aliyun)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=cdk-gpt-egress
Group=cdk-gpt-egress
ExecStart=/usr/bin/ssh -F /dev/null -N -T -o BatchMode=yes -o IdentitiesOnly=yes -o IdentityAgent=none -o StrictHostKeyChecking=yes -o UpdateHostKeys=no -o HostKeyAlgorithms=ssh-ed25519 -o UserKnownHostsFile=/var/lib/cdk-gpt-egress/known_hosts -o GlobalKnownHostsFile=/dev/null -o ExitOnForwardFailure=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no -o PreferredAuthentications=publickey -o ForwardAgent=no -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -i /var/lib/cdk-gpt-egress/id_ed25519 -L 127.0.0.1:18785:127.0.0.1:18785 cdk-gpt-egress@43.156.235.208
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=32M
CPUQuota=5%
TasksMax=16
UMask=0077

[Install]
WantedBy=multi-user.target
