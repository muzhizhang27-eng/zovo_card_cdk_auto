[Unit]
Description=CDK administration service
After=network-online.target lanting-zovo-tunnel.service cdk-gpt-tunnel.service
Wants=network-online.target lanting-zovo-tunnel.service cdk-gpt-tunnel.service

[Service]
Type=simple
Slice=cdk.slice
User=cdk-admin
Group=cdk-admin
WorkingDirectory=/var/lib/cdk-admin
EnvironmentFile=/etc/cdk-admin/app.env
ExecStart=/usr/bin/env GOMAXPROCS=1 GOMEMLIMIT=144MiB CARD_API_PROXY_URL=http://127.0.0.1:18784 GPTCHECK_PROXY_URL=http://127.0.0.1:18785 /opt/cdk-admin/current/cdk-admin
Restart=on-failure
RestartSec=3
TimeoutStopSec=330s
CPUAccounting=true
CPUQuota=50%
CPUWeight=25
CPUShares=256
MemoryAccounting=true
UMask=0077
StateDirectory=cdk-admin
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/cdk-admin
MemoryMax=192M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
