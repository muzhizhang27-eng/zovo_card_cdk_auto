[Unit]
Description=Read-only CDK status lookup over Unix socket
After=network-online.target lanting-zovo-tunnel.service
Wants=network-online.target lanting-zovo-tunnel.service

[Service]
Type=simple
Slice=cdk.slice
User=cdk-admin
Group=cdk-recharge
Environment=SERVER_MODE=release
Environment=CDK_LOOKUP_DB=/var/lib/cdk-admin/cdk_recharge.db
Environment=CDK_LOOKUP_SOCKET=/run/cdk-lookup/lookup.sock
ExecStart=/usr/bin/env GOMAXPROCS=1 GOMEMLIMIT=64MiB CARD_API_PROXY_URL=http://127.0.0.1:18784 /opt/cdk-lookup/current/cdk-lookup
RuntimeDirectory=cdk-lookup
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=3
TimeoutStopSec=330s
CPUAccounting=true
CPUQuota=50%
CPUWeight=25
CPUShares=256
MemoryAccounting=true
MemoryMax=96M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/cdk-admin
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=32
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
